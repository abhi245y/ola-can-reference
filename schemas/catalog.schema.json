{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "generation": {
      "type": "string",
      "minLength": 1
    },
    "vehicle_family": {
      "type": "string",
      "minLength": 1
    },
    "bus": {
      "type": "object",
      "properties": {
        "observed_interface": {
          "type": "string",
          "minLength": 1
        },
        "bitrate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "physical_ecu_attribution": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "observed_interface",
        "bitrate",
        "physical_ecu_attribution"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "package": {
            "type": "string",
            "minLength": 1
          },
          "version_name": {
            "type": "string",
            "minLength": 1
          },
          "apk_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "decompiler": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "package",
          "version_name",
          "apk_sha256",
          "decompiler"
        ],
        "additionalProperties": false
      }
    },
    "bit_numbering": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "static_decompilation"
              },
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "kind",
              "artifact",
              "path",
              "symbol",
              "line",
              "source_sha256"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "runtime_frame_capture"
              },
              "observation": {
                "type": "string",
                "pattern": "^observations/.+\\.json$"
              }
            },
            "required": [
              "kind",
              "observation"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "enums": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "encoding": {
            "enum": [
              "ordinal",
              "explicit"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "value",
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "encoding",
          "evidence",
          "values"
        ],
        "additionalProperties": false
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/frame"
      }
    }
  },
  "required": [
    "schema_version",
    "profile",
    "generation",
    "vehicle_family",
    "bus",
    "artifacts",
    "bit_numbering",
    "evidence",
    "enums",
    "frames"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned Ola classic-CAN reference catalog",
  "$defs": {
    "frame": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^0x[0-7][0-9A-F]{2}$"
        },
        "decimal_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2047
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "directions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "headunit_rx",
              "headunit_tx",
              "constant_only"
            ]
          }
        },
        "frame_format": {
          "const": "classic_standard"
        },
        "payload_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 8
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parsers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "enum": [
                  "recovered",
                  "decompile_gap"
                ]
              }
            },
            "required": [
              "method",
              "evidence",
              "body"
            ],
            "additionalProperties": false
          }
        },
        "transmit_variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "layout": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "method",
              "evidence",
              "layout"
            ],
            "additionalProperties": false
          }
        },
        "payload_status": {
          "enum": [
            "not_curated",
            "decompile_gap",
            "partial",
            "complete"
          ]
        },
        "raw_runtime_validation": {
          "enum": [
            "unverified",
            "correlated"
          ]
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtime_observations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "decimal_id",
        "names",
        "directions",
        "frame_format",
        "payload_bytes",
        "evidence",
        "parsers",
        "transmit_variants",
        "payload_status",
        "raw_runtime_validation",
        "signals",
        "notes"
      ],
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "start_bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "bit_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "byte_order": {
          "const": "little_endian"
        },
        "signed": {
          "type": "boolean"
        },
        "scale": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "offset": {
          "type": "number"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit_confidence": {
          "enum": [
            "static_source",
            "inferred",
            "runtime_correlated",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "enum": [
            "static_source",
            "inferred",
            "runtime_correlated"
          ]
        },
        "enum": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "start_bit",
        "bit_length",
        "byte_order",
        "signed",
        "scale",
        "offset",
        "unit",
        "unit_confidence",
        "evidence",
        "confidence"
      ],
      "additionalProperties": false
    }
  }
}
